# ── Deployment Server (server/) ───────────────────────────────
PORT=3000

# Shared secret for the DeployBase GitHub bot. Use the same value in first-app/.env.
# Generate one with:  openssl rand -hex 32
DEPLOYMENT_API_TOKEN=

# Secret configured on the GitHub repository/App webhook that points at
# POST /api/webhook/github. The endpoint is disabled until this is set.
GITHUB_WEBHOOK_SECRET=

# Who may create accounts. When both are empty, only the first account (the owner) can sign up.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Optional: sign session tokens with this key. If unset, the AES master key
# (ENCRYPTION_MASTER_KEY, generated on first start) is used.
# JWT_SECRET=

# Google / GitHub sign-in (can also be set from the dashboard on first run)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Dashboard hosted on another origin (e.g. Vercel), comma-separated
# FRONTEND_ORIGINS=https://your-dashboard.vercel.app

# Local development only: allow email-only sign-in without OAuth.
# ALLOW_DEV_LOGIN=true

GITHUB_APP_SLUG=deploybase
# Optional: use the exact GitHub App installation URL when the app slug is different.
# GITHUB_APP_URL=https://github.com/apps/deploybase/installations/new
